rec {
  # Relative luminance of a six-digit hex color (no "#"), from 0 to 1.
  luminance = hex: 0.2126 * channel hex 0 + 0.7152 * channel hex 2 + 0.0722 * channel hex 4;

  # WCAG contrast ratio between two colors, from 1 to 21.
  contrastRatio =
    a: b:
    let
      la = luminance a;
      lb = luminance b;
    in
    (lib.max la lb + 0.05) / (lib.min la lb + 0.05);
}
