{
  name = "Blue Crab Light";
  author = "chrisppy";
  variant = "light";
  # The light counterpart of Blue Crab; accents are deepened to stay readable.
  # Every accent from base08 to base0F reaches at least 4.5:1 contrast on base00
  # and base01.

  base00 = "eef4f2"; # Sea foam — primary background
  base01 = "e3ecea"; # Pale foam — panels / secondary background
  base02 = "d1dedb"; # Mist — selection / highlighted background
  base03 = "92a7a4"; # Murky teal — comments / inactive elements
  base04 = "5a706d"; # Deep teal — muted foreground
  base05 = "13282d"; # Deep bay — primary foreground
  base06 = "0b1c20"; # Deep bay — bright foreground
  base07 = "08161a"; # Deep bay — maximum contrast
  base08 = "c42909"; # Deep Maryland red — variables / errors
  base09 = "a74902"; # Deep claw orange — numbers / constants
  base0A = "865e0d"; # Deep Maryland gold — classes / warnings
  base0B = "2f7349"; # Deep bay grass — strings / success
  base0C = "1f706e"; # Deep crab teal — support / escapes
  base0D = "1b66b8"; # Deep Chesapeake blue — functions / links
  base0E = "ae3974"; # Deep oyster pink — keywords
  base0F = "7c6141"; # Deep crab spice — deprecated / embedded

  # Base24 extensions
  base10 = "e9f0ee"; # Pale foam — darker background
  base11 = "e3ebe8"; # Pale foam — darkest background
  base12 = "b02508"; # Intense Maryland red — bright red
  base13 = "78540c"; # Intense Maryland gold — bright yellow
  base14 = "2a6641"; # Intense bay grass — bright green
  base15 = "1b6463"; # Intense crab teal — bright cyan
  base16 = "185ba4"; # Intense Chesapeake blue — bright blue
  base17 = "9b3368"; # Intense oyster pink — bright magenta
}
