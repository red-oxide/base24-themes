{
  name = "Spangled";
  author = "chrisppy";
  variant = "dark";
  # Frederick, Maryland: the hometown of Francis Scott Key, and fireworks over
  #   the ballpark. Orange and black, firework red and gold, and a night-sky
  #   navy background.
  # Every accent from base08 to base0F reaches at least 4.5:1 contrast on base00
  # and base01.

  base00 = "0b0d14"; # Night navy — primary background
  base01 = "141722"; # Night navy — panels / secondary background
  base02 = "262a3a"; # Dusk blue — selection / highlighted background
  base03 = "434860"; # Slate — comments / inactive elements
  base04 = "8a8fa3"; # Gray blue — muted foreground
  base05 = "e6e1d6"; # Cream — primary foreground
  base06 = "f2efe8"; # Warm white — bright foreground
  base07 = "fffdf8"; # White — maximum contrast
  base08 = "e8513a"; # Firework red — variables / errors
  base09 = "f06a1d"; # Ballpark orange — numbers / constants
  base0A = "f2b632"; # Firework gold — classes / warnings
  base0B = "7fae5e"; # Outfield green — strings / success
  base0C = "8cc4d8"; # Star white blue — support / escapes
  base0D = "8ea6e0"; # Evening blue — functions / links
  base0E = "d98bc0"; # Firework pink — keywords
  base0F = "b79a6a"; # Brass key — deprecated / embedded

  # Base24 extensions
  base10 = "07080d"; # Night navy — darker background
  base11 = "030407"; # Night navy — darkest background
  base12 = "ff6b52"; # Bright firework red — bright red
  base13 = "ffcc55"; # Bright firework gold — bright yellow
  base14 = "99c878"; # Bright outfield green — bright green
  base15 = "a9daea"; # Bright star blue — bright cyan
  base16 = "aabcf0"; # Bright evening blue — bright blue
  base17 = "eaa6d3"; # Bright firework pink — bright magenta
}
